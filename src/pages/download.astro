---
import Base from '../layouts/Base.astro';
import { STORE_LINKS } from '../lib/store';
const DL = STORE_LINKS.mietore_site_download;
---
<Base title="アプリをダウンロード" description="ミエトレは iPhone / Android で無料。お使いのストアからダウンロードできます。">
  <section class="sec container" style="text-align:center">
    <h1 class="sec-title">アプリをダウンロード</h1>
    <p>スマートフォンで、お使いのストアを選んでください。無料です。</p>
    <p style="margin-top:20px"><a class="btn" href={DL.ios}>App Store（iPhone）</a></p>
    <p style="margin-top:12px"><a class="btn" href={DL.android}>Google Play（Android）</a></p>
  </section>
</Base>
